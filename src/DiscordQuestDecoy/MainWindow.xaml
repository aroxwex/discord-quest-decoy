<Window x:Class="DiscordQuestDecoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DiscordQuestDecoy.Services"
        Title="Discord Quest Decoy" Icon="Assets/icon.ico" Width="1000" Height="640" MinWidth="900" MinHeight="580"
        Background="#0E0E0E" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/logo.png" Width="34" Height="34" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Discord Quest Decoy" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding L[app_tagline]}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Width="36" Height="36" Padding="0" Click="Settings_Click"
                        FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE713;"
                        ToolTip="{Binding L[settings_title]}"/>
            </Grid>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <TextBox x:Name="SearchBox" Height="42" FontSize="14"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchBox_KeyDown" GotFocus="SearchBox_GotFocus"/>
            <TextBlock Text="{Binding SearchPlaceholder}" FontSize="14" Margin="14,0,0,0"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Panels -->
        <Grid Grid.Row="2" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- My games -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,14,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="8,0,8,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MyGamesCountText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding L[mygames_title]}" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>

                    <ListBox x:Name="GamesList" Grid.Row="1" Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource GameRowStyle}"
                             ItemsSource="{Binding MyGames}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             KeyDown="GamesList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DotOffBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ExeLabel}" Margin="10,0,4,0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                               MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="RemoveBtn" Grid.Column="3" Style="{StaticResource GhostButton}"
                                            Content="&#215;" FontSize="16" Padding="6,0" Opacity="0"
                                            Click="RemoveRow_Click"
                                            ToolTip="{Binding DataContext.L[mygames_remove], RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RemoveBtn" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RemoveBtn" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="{Binding L[mygames_empty]}" Margin="24" TextAlignment="Center"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding HasNoGames, Converter={StaticResource B2V}}"/>
                </Grid>
            </Border>

            <!-- Selected game -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="{Binding L[sel_hint]}" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding ShowHint, Converter={StaticResource B2V}}"/>

                    <Grid Visibility="{Binding HasSelected, Converter={StaticResource B2V}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="{Binding L[sel_label]}" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="SemiBold"
                                           Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedSubtitle}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource GhostButton}" Click="RemoveSelected_Click" FontSize="12">
                                <TextBlock Text="{Binding L[sel_remove]}" TextDecorations="Underline"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="{Binding L[exe_label]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <ListBox Style="{StaticResource ChipListBox}"
                                     ItemsSource="{Binding Selected.Exes}"
                                     SelectedItem="{Binding Selected.SelectedExe, Mode=TwoWay}"
                                     IsEnabled="{Binding Selected.CanEdit}"/>
                        </StackPanel>

                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="16,14" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}" Background="{StaticResource ListBgBrush}"
                                Visibility="{Binding Selected.IsRunning, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding L[status_running]}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding L[status_hint]}" Margin="0,8,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="42" FontSize="14" Style="{StaticResource PrimaryButton}"
                                    Content="{Binding L[btn_play]}" Click="Play_Click"
                                    Visibility="{Binding Selected.CanEdit, Converter={StaticResource B2V}}"/>
                            <Button Grid.Column="0" Height="42" FontSize="14" Style="{StaticResource DangerButton}"
                                    Content="{Binding L[btn_stop]}" Click="Stop_Click"
                                    Visibility="{Binding Selected.IsRunning, Converter={StaticResource B2V}}"/>
                            <Button Grid.Column="1" Height="42" Margin="10,0,0,0" Padding="18,0"
                                    Content="{Binding StopAllText}" Click="StopAll_Click"
                                    Visibility="{Binding HasRunning, Converter={StaticResource B2V}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="{Binding FooterText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search results dropdown (drawn on top of everything) -->
        <Border x:Name="ResultsPanel" Grid.RowSpan="4" Panel.ZIndex="10" VerticalAlignment="Top"
                Margin="24,126,24,0" MaxHeight="320" Padding="6" CornerRadius="10" BorderThickness="1"
                BorderBrush="{StaticResource LineBrush}" Background="#1E1E1E"
                Visibility="{Binding ShowResults, Converter={StaticResource B2V}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <ListBox Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource ResultRowStyle}"
                         ItemsSource="{Binding SearchResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding ExeText}" Margin="12,0" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" HorizontalAlignment="Right" Padding="12,5" FontSize="12"
                                        Style="{StaticResource PrimaryButton}" Click="AddResult_Click"
                                        Content="{Binding [search_add], Source={x:Static svc:Loc.Instance}}"
                                        Visibility="{Binding CanAdd, Converter={StaticResource B2V}}"/>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding [search_added], Source={x:Static svc:Loc.Instance}}"
                                           Visibility="{Binding IsAdded, Converter={StaticResource B2V}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding L[search_noresults]}" Margin="12,10" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding NoResults, Converter={StaticResource B2V}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
