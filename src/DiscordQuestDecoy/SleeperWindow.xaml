<Window x:Class="DiscordQuestDecoy.SleeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="180" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <StackPanel VerticalAlignment="Center" Margin="24">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="BodyText" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
