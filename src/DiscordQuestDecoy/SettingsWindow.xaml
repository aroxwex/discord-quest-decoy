<Window x:Class="DiscordQuestDecoy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding L[settings_title]}" Icon="Assets/icon.ico" Width="540" Height="700" MinWidth="480" MinHeight="480"
        Background="#0E0E0E" Foreground="#EDEDED" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="B2V"/>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Text="{Binding L[settings_title]}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- General -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding L[settings_general]}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding L[settings_language]}" Margin="0,14,0,8"/>
                    <ListBox x:Name="LangList" Style="{StaticResource ChipListBox}"
                             DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="Lang_Changed"/>
                    <CheckBox Margin="0,6,0,0" Content="{Binding L[settings_stoponexit]}"
                              IsChecked="{Binding StopOnExit, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Game list -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding L[settings_list]}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding ListInfo}" Margin="0,14,0,12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"/>
                    <CheckBox Content="{Binding L[settings_autoupdate]}" IsChecked="{Binding AutoUpdateList, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding L[settings_updatenow]}" Click="UpdateNow_Click"/>
                        <Button Content="{Binding L[settings_clearcache]}" Click="ClearCache_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ListStatus}" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Folders -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding L[settings_folders]}" Style="{StaticResource SectionLabel}"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{Binding L[settings_opendata]}" Click="OpenData_Click" Margin="0,0,10,8"/>
                        <Button Content="{Binding L[settings_openlang]}" Click="OpenLang_Click" Margin="0,0,10,8"/>
                        <Button Content="{Binding L[settings_openextra]}" Click="OpenExtra_Click" Margin="0,0,10,8"/>
                        <Button Content="{Binding L[settings_openlog]}" Click="OpenLog_Click" Margin="0,0,10,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding L[settings_about]}" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Text="Discord Quest Decoy"/>
                    <TextBlock Text="{Binding VersionText}" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"/>
                    <Button Content="{Binding L[settings_github]}" Click="GitHub_Click" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Visibility="{Binding HasRepo, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding L[settings_disclaimer]}" Margin="0,14,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
