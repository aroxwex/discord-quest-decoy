<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DiscordQuestDecoy</AssemblyName>
    <RootNamespace>DiscordQuestDecoy</RootNamespace>
    <Product>Discord Quest Decoy</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\gamelist.min.json" LogicalName="gamelist.min.json" />
    <EmbeddedResource Include="Languages\en.json" LogicalName="lang.en.json" />
    <EmbeddedResource Include="Languages\tr.json" LogicalName="lang.tr.json" />
  </ItemGroup>

</Project>
